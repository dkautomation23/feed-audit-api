# Demo values for a local run only. Copy to .env and change them.
POSTGRES_USER=feedaudit
POSTGRES_PASSWORD=feedaudit
POSTGRES_DB=feedaudit
DATABASE_URL=postgresql+psycopg://feedaudit:feedaudit@localhost:5435/feedaudit
API_KEY=demo-key-change-me
MAX_UPLOAD_BYTES=5242880
# Where docker compose takes the engine from. The default is the pinned commit
# on GitHub; point it at a local checkout to build before that commit is public.
# ENGINE_CONTEXT=../feed-to-matrixify
